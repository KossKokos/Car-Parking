# APP
APP_HOST=0.0.0.0
APP_PORT=80
APP_DEBUG=false
APP_RELOAD=false

# API SECRETS
SECRET_KEY=
ALGORITHM=

# POSTGRESQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# SQLALCHEMY URL
SQLALCHEMY_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# OPTIONAL REDIS
# Reserved for future Redis-backed app logic and /health/redis.
REDIS_URL=redis://localhost:6380/0

# EMAIL CONNECTION
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=
MAIL_SERVER=

# DATABASE CHECKS
REQUIRED_TABLES='["users_table", "parking_places_table", "cars_table", "tariffs_table", "parking_count_table", "blacklisted_tokens"]'
